# For Claude, add your Anthropic API key here.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Alternatively, use an OpenAI API key:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional. OCR language data must be installed with Tesseract.
# TENDERREADY_OCR_LANGUAGE=eng

# Optional. Defaults to ./data/tenderready.sqlite3
# TENDERREADY_DB_PATH=./data/tenderready.sqlite3
