# For Claude, add your Anthropic API key here.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Alternatively, use an OpenAI API key:
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional. OCR language data must be installed with Tesseract.
# TENDERREADY_OCR_LANGUAGE=eng

# Optional. Defaults to ./data/tenderready.sqlite3
# TENDERREADY_DB_PATH=./data/tenderready.sqlite3

# Deployment: set APP_ENV=production and a strong SESSION_SECRET. DATABASE_URL
# can point to a PostgreSQL database. TESTER_ACCESS_CODE is optional: leave it
# unset for a public site (each visitor gets a private session), or set it to
# require a shared access code.
# APP_ENV=production
# SESSION_SECRET=
# TESTER_ACCESS_CODE=
# DATABASE_URL=
